{
    // Browser-context pass: js/**/*.js, tests_js/**/*.js and the project's own command declarations, except the
    // Node-context files tsconfig.node.json checks.
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ES2022", "DOM"],
        // import.meta.glob (tests_js/_generated_definitions.js) and ?raw imports need Vite's client types;
        // naming them also keeps Node's ambient types out of this browser-context pass.
        "types": ["vite/client"]
    },
    "include": ["js/**/*.js", "tests_js/**/*.js", "tests_js/vitest-commands.ts"],
    // The Node-context files run in Node (Vitest's Commands API, their helpers, the summary reporter): their Node globals
    // must not leak into this browser program, the digital_twin/typecheck.ini split's reason (SPECIFICATION.md H.8).
    "exclude": ["tests_js/_live_twin_command.js", "tests_js/_live_matrix_command.js", "tests_js/_lint_command.js", "tests_js/_summary_reporter.js", "tests_js/_port_lock.js", "tests_js/_twin_process.js"]
}
