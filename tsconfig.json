{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM"],
        // import.meta.glob (tests_js/_generated_definitions.js) and ?raw imports need Vite's client types;
        // naming them also keeps Node's ambient types out of this browser-context pass.
        "types": ["vite/client"],
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        // Everything TypeScript offers beyond `strict`, mirroring pyproject.toml's mypy settings
        // on the Python side. All of these were verified to hold before being switched on; the two
        // that needed real fixes (exactOptionalPropertyTypes, noUncheckedIndexedAccess) were fixed
        // in js/ rather than left off. skipLibCheck stays TRUE deliberately: the only findings it
        // hides are inside third-party .d.ts files this project does not own.
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "allowUnreachableCode": false,
        "allowUnusedLabels": false,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true
    },
    "include": ["js/**/*.js", "tests_js/**/*.js", "tests_js/**/*.d.ts"],
    // The Node-context tests_js files (Vitest Commands API modules, the summary reporter) are checked by
    // tsconfig.node.json instead, so this browser-context pass never sees Node's ambient globals as if a
    // browser had them - the same two-environment split as digital_twin/typecheck.ini (SPECIFICATION.md H.8).
    "exclude": ["tests_js/_live_twin_command.js", "tests_js/_live_matrix_command.js", "tests_js/_lint_command.js", "tests_js/_summary_reporter.js"]
}
