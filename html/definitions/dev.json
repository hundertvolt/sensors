{
    "schemaVersion": "1.0.0",
    "device": { "id": "dev", "displayName": "dev" },
    "landingSection": "measurements",
    "defaultPollIntervalMs": 3000,
    "sections": [
        {
            "key": "measurements",
            "label": "Measurements",
            "description": "Live sensor readings, refreshed automatically.",
            "rest": { "get": "/measurements" },
            "pollGroup": "live",
            "groups": [
                {
                    "key": "SCD30",
                    "label": "SCD30 — CO2, Temperature, Humidity",
                    "fields": [
                        { "key": "CO2", "label": "CO2", "unit": "ppm", "kind": "readonly" },
                        { "key": "Temp", "label": "Temperature", "unit": "°C", "kind": "readonly" },
                        { "key": "Hum", "label": "Relative Humidity", "unit": "%", "kind": "readonly" },
                        { "key": "WetBulb", "label": "Wet Bulb Temperature", "unit": "°C", "kind": "readonly" },
                        { "key": "DewPoint", "label": "Dew Point", "unit": "°C", "kind": "readonly" },
                        { "key": "TS", "label": "Timestamp", "unit": "s", "kind": "readonly" }
                    ]
                },
                {
                    "key": "SGP40",
                    "label": "SGP40 — VOC Index",
                    "fields": [
                        { "key": "VOC", "label": "VOC Index", "kind": "readonly" },
                        { "key": "Raw", "label": "VOC Raw", "unit": "ticks", "kind": "readonly" },
                        { "key": "TS", "label": "Timestamp", "unit": "s", "kind": "readonly" }
                    ]
                },
                {
                    "key": "BMP3XX",
                    "label": "BMP388 — Pressure, Temperature",
                    "fields": [
                        { "key": "Pres", "label": "Pressure", "unit": "hPa", "kind": "readonly" },
                        { "key": "Temp", "label": "Temperature", "unit": "°C", "kind": "readonly" },
                        { "key": "SLPres", "label": "Sea Level Pressure", "unit": "hPa", "kind": "readonly" },
                        { "key": "TS", "label": "Timestamp", "unit": "s", "kind": "readonly" }
                    ]
                },
                {
                    "key": "ISL29125",
                    "label": "ISL29125 — Light, Colour",
                    "fields": [
                        { "key": "Lux", "label": "Illuminance", "unit": "lx", "kind": "readonly", "decimals": 2 },
                        {
                            "key": "R", "label": "Red", "path": ["RGB", "R"], "kind": "readonly", "decimals": 4,
                            "description": "Sensor red, normalised over the whole auto-range span (10000 lx). Relative colour, not a colorimetric measurement."
                        },
                        { "key": "G", "label": "Green", "path": ["RGB", "G"], "kind": "readonly", "decimals": 4 },
                        { "key": "B", "label": "Blue", "path": ["RGB", "B"], "kind": "readonly", "decimals": 4 },
                        { "key": "H", "label": "Hue", "unit": "°", "path": ["HSB", "H"], "kind": "readonly", "decimals": 1 },
                        { "key": "S", "label": "Saturation", "path": ["HSB", "S"], "kind": "readonly", "decimals": 3 },
                        {
                            "key": "Bri", "label": "Brightness", "path": ["HSB", "B"], "kind": "readonly", "decimals": 4,
                            "description": "Same scale and denominator as RGB, so a dim room reads near 0.003. Read Illuminance when magnitude matters."
                        },
                        {
                            "key": "CCT", "label": "Colour Temperature", "unit": "K", "kind": "readonly", "decimals": 0,
                            "description": "Relative and uncalibrated — a documented placeholder RGB→XYZ matrix, so repeatable and monotonic rather than a colorimeter reading. Blank below the low-light floor."
                        },
                        {
                            "key": "RangeAct", "label": "Active Range", "unit": "lx", "kind": "readonly", "decimals": 0,
                            "description": "The full-scale range this sample was taken on, which under automatic ranging is not always the one currently programmed."
                        },
                        { "key": "TS", "label": "Timestamp", "unit": "s", "kind": "readonly", "decimals": 0 }
                    ]
                }
            ]
        },
        {
            "key": "sensors",
            "label": "Sensors",
            "description": "Per-sensor configuration. Each card applies independently.",
            "rest": { "get": "/sensors", "put": "/sensors" },
            "pollGroup": "settings",
            "groups": [
                {
                    "key": "SCD30",
                    "label": "SCD30 — CO2, Temperature, Humidity",
                    "submit": true,
                    "fields": [
                        { "key": "MeasInt", "label": "Measurement Interval", "unit": "s", "kind": "number", "min": 2, "max": 1800 },
                        { "key": "TempOffs", "label": "Temperature Offset", "unit": "K", "kind": "number", "min": 0.0, "max": 655.35, "float": true },
                        {
                            "key": "AmbPres", "label": "Ambient Pressure (starts continuous measurement)", "unit": "hPa", "kind": "number",
                            "min": 700, "max": 1400,
                            "specialValues": [{ "value": 0, "meaning": "Compensation off / use Altitude" }]
                        },
                        {
                            "key": "Altitude", "label": "Altitude above sea level", "unit": "m", "kind": "number", "min": 0, "max": 65535,
                            "description": "Only used if Ambient Pressure is 0."
                        },
                        {
                            "key": "ContMeas", "label": "Continuous Measurement", "kind": "toggle", "onLabel": "On", "offLabel": "Off",
                            "description": "Setting this to Off stops continuous measurement; restart it via Ambient Pressure above.",
                            "defaultValue": true
                        },
                        { "key": "ForceCalRef", "label": "Forced Calibration Reference", "unit": "ppm", "kind": "number", "min": 400, "max": 2000 },
                        { "key": "SelfCal", "label": "Automatic Self-Calibration", "kind": "toggle", "onLabel": "On", "offLabel": "Off" }
                    ]
                },
                {
                    "key": "SGP40",
                    "label": "SGP40 — VOC Index",
                    "submit": true,
                    "fields": [
                        {
                            "key": "BackupPeriod", "label": "VOC Index Backup Interval", "unit": "min", "kind": "number", "min": 0, "max": 1440,
                            "specialValues": [{ "value": 0, "meaning": "Backups off" }]
                        },
                        {
                            "key": "BackupMaxAge", "label": "VOC Index Backup Max Age", "unit": "min", "kind": "number", "min": 0, "max": 10080,
                            "specialValues": [{ "value": 0, "meaning": "Use all found backups" }]
                        },
                        {
                            "key": "WaitTimeNTP", "label": "VOC Index NTP Wait Time", "unit": "s", "kind": "number", "min": 0, "max": 600,
                            "specialValues": [{ "value": 0, "meaning": "Never wait for NTP sync" }]
                        },
                        {
                            "key": "SGPResetVOC", "label": "Reset VOC Index", "kind": "toggle", "onLabel": "On", "offLabel": "Off",
                            "description": "Only 'On' has effect. Resets the VOC algorithm and deletes the current backup.",
                            "dispatch": true
                        }
                    ]
                },
                {
                    "key": "BMP3XX",
                    "label": "BMP388 — Pressure, Temperature",
                    "submit": true,
                    "fields": [
                        { "key": "SampleInterv", "label": "Measurement Interval", "unit": "s", "kind": "number", "min": 1, "max": 3600 },
                        { "key": "PressOvers", "label": "Pressure Oversampling", "kind": "enum", "options": [
                            { "value": 1, "label": "×1" }, { "value": 2, "label": "×2" }, { "value": 4, "label": "×4" },
                            { "value": 8, "label": "×8" }, { "value": 16, "label": "×16" }, { "value": 32, "label": "×32" }
                        ] },
                        { "key": "PressOffset", "label": "Pressure Offset", "unit": "hPa", "kind": "number", "min": -500.0, "max": 500.0, "float": true },
                        { "key": "TempOvers", "label": "Temperature Oversampling", "kind": "enum", "options": [
                            { "value": 1, "label": "×1" }, { "value": 2, "label": "×2" }, { "value": 4, "label": "×4" },
                            { "value": 8, "label": "×8" }, { "value": 16, "label": "×16" }, { "value": 32, "label": "×32" }
                        ] },
                        { "key": "TempOffset", "label": "Temperature Offset", "unit": "K", "kind": "number", "min": -10.0, "max": 10.0, "float": true },
                        {
                            "key": "FiltCoeff", "label": "Filter Coefficient", "kind": "enum",
                            "description": "First-order IIR lowpass filter coefficient.",
                            "options": [
                                { "value": 0, "label": "Off" }, { "value": 1, "label": "1" }, { "value": 3, "label": "3" },
                                { "value": 7, "label": "7" }, { "value": 15, "label": "15" }, { "value": 31, "label": "31" },
                                { "value": 63, "label": "63" }, { "value": 127, "label": "127" }
                            ]
                        },
                        { "key": "SeaLevelOffs", "label": "Sensor Sea Level Offset", "unit": "m", "kind": "number", "min": -1000.0, "max": 5000.0, "float": true },
                        { "key": "MeanAtmTemp", "label": "Mean Atmospheric Temperature", "unit": "°C", "kind": "number", "min": -50.0, "max": 50.0, "float": true }
                    ]
                },
                {
                    "key": "ISL29125",
                    "label": "ISL29125 — Light, Colour",
                    "submit": true,
                    "fields": [
                        { "key": "SampleInterv", "label": "Measurement Interval", "unit": "s", "kind": "number", "min": 1, "max": 3600 },
                        {
                            "key": "Resolution", "label": "ADC Resolution", "kind": "enum",
                            "description": "16 bit integrates for 101 ms, an exact multiple of both the 50 Hz and 60 Hz mains period, so it rejects lighting flicker. 12 bit is ~16× faster and rejects none.",
                            "options": [ { "value": 12, "label": "12 bit (fast)" }, { "value": 16, "label": "16 bit (flicker-rejecting)" } ]
                        },
                        {
                            "key": "RangeAuto", "label": "Automatic Range", "kind": "toggle", "onLabel": "Auto", "offLabel": "Fixed",
                            "description": "Switches gain between the two ranges on its own, using the chip's threshold interrupt as the fast path and every periodic read as the guaranteed one."
                        },
                        {
                            "key": "Range", "label": "Fixed Range", "unit": "lx", "kind": "enum",
                            "description": "Used only while Automatic Range is off.",
                            "options": [ { "value": 375, "label": "375 lx" }, { "value": 10000, "label": "10000 lx" } ]
                        },
                        {
                            "key": "AutoRangeUp", "label": "Switch-Up Point", "unit": "%", "kind": "number", "min": 50.0, "max": 95.0, "float": true,
                            "description": "Percent of the low range's full scale above which the driver switches up."
                        },
                        {
                            "key": "AutoRangeDown", "label": "Switch-Down Point", "unit": "%", "kind": "number", "min": 0.2, "max": 3.0, "float": true,
                            "description": "Percent of the high range's full scale below which the driver switches back down. Must stay at or below Switch-Up Point / 53.3, or the loop chatters on noise alone."
                        },
                        {
                            "key": "AutoRangeSettle", "label": "Settle Margin", "unit": "cycles", "kind": "number", "min": 1, "max": 10,
                            "description": "Full conversion cycles discarded after any range or resolution change, each of which restarts the conversion."
                        },
                        {
                            "key": "AutoRangePersist", "label": "Transient Rejection", "kind": "enum",
                            "description": "How many consecutive RGB cycles a light change must persist before the chip raises its threshold interrupt. Each cycle is ~303 ms at 16 bit.",
                            "options": [
                                { "value": 1, "label": "1 cycle" }, { "value": 2, "label": "2 cycles" },
                                { "value": 4, "label": "4 cycles" }, { "value": 8, "label": "8 cycles" }
                            ]
                        },
                        {
                            "key": "AutoRangeDwell", "label": "Switch-Down Dwell", "unit": "s", "kind": "number", "min": 0.0, "max": 300.0, "float": true,
                            "description": "Minimum time on the high range before a switch back down is honoured, so a passing shadow does not cost a range change.",
                            "specialValues": [ { "value": 0.0, "meaning": "No dwell — hardware persistence alone" } ]
                        },
                        {
                            "key": "IrCompOffset", "label": "IR Compensation Offset", "kind": "enum",
                            "description": "Adds 106 codes on top of IR Compensation Adjust. Changing IR compensation shifts the lux scale.",
                            "options": [ { "value": 0, "label": "Off (0-63 codes)" }, { "value": 1, "label": "On (106-169 codes)" } ]
                        },
                        {
                            "key": "IrCompAdjust", "label": "IR Compensation Adjust", "unit": "codes", "kind": "number", "min": 0, "max": 63,
                            "description": "Fine infrared rejection. Changing it shifts the lux scale: the reported full scale is nominal at one setting only."
                        },
                        {
                            "key": "FiltCoeff", "label": "Output Filter", "kind": "number", "min": -1.0, "max": 1.0, "float": true,
                            "description": "First-order exponential moving average over the measured channels, stepped once per read cycle.",
                            "specialValues": [ { "value": -1.0, "meaning": "Filter off" } ]
                        },
                        {
                            "key": "ISLResetCal", "label": "Reset Gain Calibration", "kind": "toggle", "onLabel": "On", "offLabel": "Off",
                            "description": "Only 'On' has effect. Discards the learned range-gain ratio and relearns it from the nominal 26.67.",
                            "dispatch": true, "defaultValue": false
                        }
                    ]
                }
            ]
        },
        {
            "key": "networking",
            "label": "Networking",
            "description": "Wi-Fi credentials, identity, and NTP time sync. Live status (IP, RSSI, uptime, sync age) is on the Status page.",
            "rest": { "get": "/networking", "put": "/networking" },
            "pollGroup": "settings",
            "groups": [
                {
                    "key": "identity",
                    "label": "Wi-Fi & Identity",
                    "submit": true,
                    "fields": [
                        { "key": "SSID", "label": "Wi-Fi SSID", "kind": "string", "minLength": 0, "maxLength": 32 },
                        { "key": "PW", "label": "Wi-Fi Password", "kind": "string", "minLength": 8, "maxLength": 63, "mask": true },
                        { "key": "Country", "label": "Country", "kind": "string", "minLength": 2, "maxLength": 2, "description": "Two-letter ISO 3166 country code." },
                        { "key": "Hostname", "label": "Hostname", "kind": "string", "minLength": 1, "maxLength": 32 }
                    ]
                },
                {
                    "key": "wifiLed",
                    "label": "Wi-Fi Status LED",
                    "submit": true,
                    "fields": [
                        { "key": "LedWifiOn", "label": "Wi-Fi Status LED", "kind": "toggle", "onLabel": "On", "offLabel": "Off" }
                    ]
                },
                {
                    "key": "ntp",
                    "label": "NTP Time Sync",
                    "submit": true,
                    "fields": [
                        { "key": "NTP_Host", "label": "NTP Server Address", "kind": "string", "minLength": 3, "maxLength": 1024 },
                        { "key": "NTP_Offset_S", "label": "NTP Offset", "unit": "s", "kind": "number", "min": -43200, "max": 43200, "description": "Added to Unix time; affects system time and all timestamps." },
                        { "key": "NTP_Interv_H", "label": "NTP Sync Interval", "unit": "h", "kind": "number", "min": 1, "max": 24 }
                    ]
                }
            ]
        },
        {
            "key": "system",
            "label": "System",
            "rest": { "get": "/system", "put": "/system" },
            "pollGroup": "settings",
            "groups": [
                {
                    "key": "settings",
                    "label": "System Settings",
                    "submit": true,
                    "fields": [
                        { "key": "DebugLevel", "label": "Debug Level", "kind": "number", "min": 0, "max": 5 },
                        { "key": "GMTOffset", "label": "GMT Offset", "unit": "s", "kind": "number", "min": -43200, "max": 43200, "description": "Timezone offset to GMT; affects local time only." },
                        { "key": "DSTOffset", "label": "DST Offset", "unit": "s", "kind": "number", "min": -43200, "max": 43200, "description": "Daylight Savings offset; affects local time only." }
                    ]
                },
                {
                    "key": "command",
                    "label": "System Command",
                    "submit": true,
                    "fields": [
                        { "key": "SystemCmd", "label": "Command", "kind": "enum", "dispatch": true, "options": [
                            { "value": "reboot", "label": "Reboot" },
                            { "value": "bootloader", "label": "Reboot into bootloader" },
                            { "value": "mempause", "label": "Pause backups for 5 minutes" }
                        ] }
                    ]
                }
            ]
        },
        {
            "key": "status",
            "label": "Status",
            "description": "Live system/network/error state. Error counts are always visible; click a module to see its history.",
            "rest": { "get": "/status", "put": "/status" },
            "pollGroup": "live",
            "pollIntervalMs": 3000,
            "groups": [
                {
                    "key": "networking",
                    "label": "Networking Status",
                    "fields": [
                        { "key": "Mode", "label": "Wi-Fi Mode", "kind": "readonly" },
                        { "key": "Connected", "label": "Connected", "kind": "readonly" },
                        { "key": "IP", "label": "IP Address", "kind": "readonly" },
                        { "key": "IPv4", "label": "IPv4 Address", "kind": "readonly" },
                        { "key": "Subnet", "label": "Subnet Mask", "kind": "readonly" },
                        { "key": "Gateway", "label": "Gateway", "kind": "readonly" },
                        { "key": "DNS", "label": "Name Server", "kind": "readonly" },
                        { "key": "Rssi", "label": "Wi-Fi RSSI", "unit": "dBm", "kind": "readonly" },
                        { "key": "WifiUptime", "label": "Wi-Fi Uptime", "unit": "s", "kind": "readonly" },
                        { "key": "NtpSynced", "label": "NTP Synced", "kind": "readonly" },
                        { "key": "NtpLastSyncAge", "label": "NTP Last Sync Age", "unit": "s", "kind": "readonly" },
                        { "key": "NtpLastSync", "label": "NTP Last Sync Time", "unit": "s", "kind": "readonly", "description": "Unix timestamp of the last successful sync." }
                    ]
                },
                {
                    "key": "system",
                    "label": "System Status",
                    "fields": [
                        { "key": "SysUptime", "label": "System Uptime", "unit": "s", "kind": "readonly" },
                        {
                            "key": "BootSignature", "label": "Boot Signature", "kind": "readonly",
                            "description": "Opaque value, stable for the running boot session; a different value on a later poll means the device rebooted. Not a human-readable code."
                        },
                        { "key": "MemPaused", "label": "Backups Paused", "kind": "readonly" },
                        { "key": "LocalTime", "label": "Local Time", "kind": "readonly", "format": "gmtimestruct" },
                        { "key": "UtcTime", "label": "UTC Time", "kind": "readonly", "format": "gmtimestruct" }
                    ]
                },
                {
                    "key": "sensors",
                    "label": "Sensor Maintenance",
                    "fields": [
                        { "key": "SGP40_BackupTS", "label": "SGP40 Last Backup", "kind": "readonly" },
                        { "key": "SGP40_RestoreTS", "label": "SGP40 Restore Timestamp", "kind": "readonly" },
                        { "key": "ISL29125_GainRatio", "label": "ISL29125 Learned Gain Ratio", "kind": "readonly", "decimals": 3 },
                        { "key": "ISL29125_CalTS", "label": "ISL29125 Calibration Timestamp", "kind": "readonly" }
                    ]
                },
                {
                    "key": "notification",
                    "label": "Notification Status",
                    "fields": [
                        { "key": "Triggered", "label": "Currently Triggered", "kind": "readonly" },
                        { "key": "TS", "label": "Last Trigger Timestamp", "kind": "readonly" },
                        { "key": "PauseTime", "label": "Remaining Pause Time", "unit": "s", "kind": "readonly" }
                    ]
                },
                {
                    "key": "errcount",
                    "label": "Error Counts & History",
                    "kind": "errcount",
                    "modules": [
                        { "key": "WIFI", "label": "Wi-Fi" },
                        { "key": "CFGMGR_WIFI", "label": "Wi-Fi Config Store" },
                        { "key": "DNSSRV", "label": "Captive DNS" },
                        { "key": "NTP", "label": "NTP Client" },
                        { "key": "CFGMGR_NTP", "label": "NTP Config Store" },
                        { "key": "FRAM", "label": "FRAM Storage" },
                        { "key": "SYSTEM", "label": "System" },
                        { "key": "CFGMGR_SYSTEM", "label": "System Config Store" },
                        { "key": "SCD30", "label": "SCD30" },
                        { "key": "SGP40", "label": "SGP40" },
                        { "key": "CFGMGR_SGP40", "label": "SGP40 Config Store" },
                        { "key": "BMP3XX", "label": "BMP388" },
                        { "key": "ISL29125", "label": "ISL29125" },
                        { "key": "CFGMGR_ISL29125", "label": "ISL29125 Config Store" },
                        { "key": "CFGMGR_BMP3XX", "label": "BMP388 Config Store" },
                        { "key": "NEOPIXEL", "label": "Neopixel LED" },
                        { "key": "NOTIFY", "label": "Notification Service" },
                        { "key": "CFGMGR_NOTIFY", "label": "Notification Config Store" },
                        { "key": "WEBSERVER", "label": "Web Server" }
                    ]
                },
                {
                    "key": "resetErrors",
                    "label": "Reset Errors",
                    "submit": true,
                    "submitLabel": "Reset All Errors",
                    "fields": [
                        {
                            "key": "ResetErrors", "label": "Confirm Reset", "kind": "toggle", "onLabel": "Yes, reset", "offLabel": "No",
                            "description": "Resets every module's error counter and history in one call. Absent/No is a no-op.",
                            "dispatch": true
                        }
                    ]
                }
            ]
        },
        {
            "key": "notification",
            "label": "Notification",
            "rest": { "get": "/notification", "put": "/notification" },
            "pollGroup": "settings",
            "groups": [
                {
                    "key": "autoConfig",
                    "label": "Automatic Notification Configuration",
                    "submit": true,
                    "fields": [
                        { "key": "AutoOn", "label": "Automatic Notifications", "kind": "toggle", "onLabel": "On", "offLabel": "Off", "description": "Auto On must be before Off, on the same day." },
                        { "key": "OnH", "label": "Auto On Hour", "kind": "number", "min": 0, "max": 23 },
                        { "key": "OnM", "label": "Auto On Minute", "kind": "number", "min": 0, "max": 59 },
                        { "key": "OffH", "label": "Auto Off Hour", "kind": "number", "min": 0, "max": 23 },
                        { "key": "OffM", "label": "Auto Off Minute", "kind": "number", "min": 0, "max": 59 },
                        { "key": "FlashBri", "label": "Flash Brightness", "kind": "number", "min": 1, "max": 255 },
                        { "key": "Interv", "label": "Flash Interval", "unit": "s", "kind": "number", "min": 60.0, "max": 3600.0, "float": true },
                        { "key": "FlashDur", "label": "Flash Duration", "unit": "s", "kind": "number", "min": 0.5, "max": 10.0, "float": true },
                        { "key": "WarnCO2", "label": "CO2 Warning Threshold", "unit": "ppm", "kind": "number", "min": 0, "max": 3000 },
                        { "key": "WarnVOC", "label": "VOC Warning Threshold", "kind": "number", "min": 0, "max": 500 },
                        { "key": "WarnHum", "label": "Humidity Warning Threshold", "unit": "%", "kind": "number", "min": 0.0, "max": 100.0, "float": true }
                    ]
                },
                {
                    "key": "flash",
                    "label": "Manual Flash Command",
                    "submit": true,
                    "submitLabel": "Flash LED",
                    "fields": [
                        {
                            "key": "lightCmdLED", "label": "LED Flash", "kind": "composite",
                            "subFields": [
                                { "key": "r", "label": "Red", "kind": "number", "min": 0, "max": 255 },
                                { "key": "g", "label": "Green", "kind": "number", "min": 0, "max": 255 },
                                { "key": "b", "label": "Blue", "kind": "number", "min": 0, "max": 255 },
                                { "key": "t", "label": "Time (s)", "kind": "number", "min": 0.5, "max": 60.0, "float": true }
                            ]
                        }
                    ]
                },
                {
                    "key": "pause",
                    "label": "Pause Notifications",
                    "submit": true,
                    "fields": [
                        {
                            "key": "PauseTime", "label": "Pause Time", "unit": "s", "kind": "number", "min": 0, "max": 3600,
                            "description": "Temporarily suppress automatic LED notifications. Current value is live (from Status)."
                        }
                    ]
                }
            ]
        }
    ]
}
