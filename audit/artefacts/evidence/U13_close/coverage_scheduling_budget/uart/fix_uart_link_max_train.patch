+class _PollRoundClock:
+    # The UART modules' deadlines read on a clock only they advance - by each sleep, and 1 ms per read so a wait
+    # that never yields still expires. Both ends share this interpreter: on the wall clock a host stall or a slow
+    # twin step would spend the peer's reply budget (OF-33).
+    def __enter__(self) -> "_PollRoundClock":
+        modules = (asy_uart_driver, asy_uart_comm)
+        self._saved = [(m, m.time, m.asyncio) for m in modules]
+        real_time, real_asyncio = time, asyncio
+        now = [time.ticks_ms()]  # starts at the real value: deadlines stored before entry stay comparable
+
+        class _Time:
+            ticks_add = staticmethod(real_time.ticks_add)
+            ticks_diff = staticmethod(real_time.ticks_diff)
+
+            @staticmethod
+            def ticks_ms() -> int:
+                now[0] = real_time.ticks_add(now[0], 1)
+                return now[0]
+
+        class _Asyncio:
+            Lock = real_asyncio.Lock
+            get_event_loop = staticmethod(real_asyncio.get_event_loop)
+
+            def __init__(self, inner: "ModuleType") -> None:
+                self._inner = inner  # the module's own asyncio, which really sleeps
+
+            async def sleep_ms(self, ms: int) -> None:
+                now[0] = real_time.ticks_add(now[0], ms)
+                await self._inner.sleep_ms(ms)
+
+        for m in modules:
+            m.asyncio = _Asyncio(m.asyncio)  # type: ignore[assignment]
+            m.time = _Time()  # type: ignore[assignment]
+        return self
+
+    def __exit__(self, *exc_info: object) -> None:
+        for m, t, a in self._saved:
+            m.time, m.asyncio = t, a
+
+
