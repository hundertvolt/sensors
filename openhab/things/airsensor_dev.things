Thing http:url:Luftsensor_dev "Raumluftsensor Dev" [
    baseURL="http://192.168.85.57",  //SensorNode IP
    authMode="BASIC",
    ignoreSSLErrors="true",
    refresh=3,
    commandMethod="PUT",
    stateMethod="GET",
    contentType="application/json",
    timeout=3500,
    bufferSize=2048,
    delay=1000
] 
{
    Channels:
// -----------------------------------------------

  Type number : airsensor_dev_bme688_ts "Timestamp BME688" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.BME688.TS"
        ]
  Type number : airsensor_dev_bme688_IAQ "IAQ Messwert BME688" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.BME688.IAQ"
        ]
  Type number : airsensor_dev_bme688_iaqA "IAQ Accuracy BME688" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.BME688.IAQAcc"
        ]
  Type number : airsensor_dev_bme688_iaqS "Static IAQ Messwert BME688" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.BME688.StIAQ"
        ]
  Type number : airsensor_dev_bme688_co2E "CO2 Equivalent Messwert BME688" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.BME688.CO2Eq"
        ]
  Type number : airsensor_dev_bme688_bVOCE "Breath VOC Equivalent Messwert BME688" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.BME688.bVOCEq"
        ]
  Type number : airsensor_dev_bme688_rawtemp "Raw Temperature Messwert BME688" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.BME688.RawTemp"
        ]
  Type number : airsensor_dev_bme688_press "Pressure Messwert BME688" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.BME688.Press"
        ]
  Type number : airsensor_dev_bme688_rawhum "Raw Humidity Messwert BME688" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.BME688.RawHum"
        ]
  Type number : airsensor_dev_bme688_gasres "Gas Resistance Messwert BME688" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.BME688.GasRes"
        ]
  Type number : airsensor_dev_bme688_StabSt "Stab Status BME688" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.BME688.StabSt"
        ]
  Type number : airsensor_dev_bme688_runinst "Run In Status BME688" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.BME688.RunInSt"
        ]
  Type number : airsensor_dev_bme688_comptemp "Compensated Temperature Messwert BME688" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.BME688.CompTemp"
        ]
  Type number : airsensor_dev_bme688_comphum "Compensated Humidity Messwert BME688" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.BME688.CompHum"
        ]
  Type number : airsensor_dev_bme688_gasperc "Gas Percentage Messwert BME688" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.BME688.GasPerc"
        ]

  Type number : airsensor_dev_CO2 "CO2 Messwert SCD30" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.SCD30.CO2"
        ]
  Type number : airsensor_dev_Temperature "Temperatur Messwert SCD30" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.SCD30.Temp"
        ]
  Type number : airsensor_dev_Humidity "Luftfeuchte Messwert SCD30" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.SCD30.Hum"
        ]
  Type number : airsensor_dev_WetBulb "Feuchtkugeltemperatur SCD30" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.SCD30.WetBulb"
        ]
  Type number : airsensor_dev_DewPoint "Taupunkt SCD30" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.SCD30.DewPoint"
        ]
  Type number : airsensor_dev_TS "Zeitstempel CO2 Sensor SCD30" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.SCD30.TS"
        ]
  Type number : airsensor_dev_VOC_IDX "VOC Index" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.SGP40.VOC"
        ]
  Type number : airsensor_dev_VOC_Raw "VOC Raw value" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.SGP40.Raw"
        ]
  Type number : airsensor_dev_VOC_TS "Zeitstempel VOC Index" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.SGP40.TS"
        ]
  Type number : airsensor_dev_Pressure "Luftdruck Messwert" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.MPRLS.Pres"
        ]
  Type number : airsensor_dev_TS_Press "Zeitstempel Drucksensor" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.MPRLS.TS"
        ]
  Type number : airsensor_dev_red "ISL29125 Red" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.ISL29125.Red"
        ]
  Type number : airsensor_dev_green "ISL29125 Green" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.ISL29125.Green"
        ]
  Type number : airsensor_dev_blue "ISL29125 Blue" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.ISL29125.Blue"
        ]
  Type number : airsensor_dev_TS_Press "Zeitstempel ISL29125" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.ISL29125.TS"
        ]
  Type number : airsensor_dev_rh_Temperature "Temperatur Messwert SHTC3" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.SHTC3.Temp"
        ]
  Type number : airsensor_dev_rh_Humidity "Luftfeuchte Messwert SHTC3" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.SHTC3.Hum"
        ]
  Type number : airsensor_dev_rh_WetBulb "Feuchtkugeltemperatur SHTC3" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.SHTC3.WetBulb"
        ]
  Type number : airsensor_dev_rh_DewPoint "Taupunkt SHTC3" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.SHTC3.DewPoint"
        ]
  Type number : airsensor_dev_rh_TS "Zeitstempel SHTC3" [
            stateExtension="sensors/status",
            stateTransformation="JSONPATH:$.SHTC3.TS"
        ]
  Type number : system_Uptime_dev "Sensor Uptime" [
            stateExtension="system/status",
            stateTransformation="JSONPATH:$.Sys_Uptime"
        ]
  Type number : wifi_Uptime_dev "WiFi Uptime" [
            stateExtension="system/status",
            stateTransformation="JSONPATH:$.Wifi_Uptime"
        ]
  Type number : ntp_Last_Sync_dev "Zeit seit letzem NTP Sync" [
            stateExtension="system/status",
            stateTransformation="JSONPATH:$.NTP_LastSync"
        ]
  Type number : scd30_err_cnt_dev "SCD30 Fehlerzähler" [
            stateExtension="system/status",
            stateTransformation="JSONPATH:$.SCD30_ErrCnt"
        ]
  Type number : sgp40_err_cnt_dev "SGP40 Fehlerzähler" [
            stateExtension="system/status",
            stateTransformation="JSONPATH:$.SGP40_ErrCnt"
        ]
  Type number : mprls_err_cnt_dev "MPRLS Fehlerzähler" [
            stateExtension="system/status",
            stateTransformation="JSONPATH:$.MPRLS_ErrCnt"
        ]
  Type number : shtc3_err_cnt_dev "SHTC3 Fehlerzähler" [
            stateExtension="system/status",
            stateTransformation="JSONPATH:$.SHTC3_ErrCnt"
        ]
 Type number : isl29125_err_cnt_dev "ISL29125 Fehlerzähler" [
            stateExtension="system/status",
            stateTransformation="JSONPATH:$.ISL29125_ErrCnt"
        ]
  Type number : task_err_cnt_dev "Task Fehlerzähler" [
            stateExtension="system/status",
            stateTransformation="JSONPATH:$.Task_ErrCnt"
        ]
  Type number : task_last_err_dev "Letzter Taskfehler" [
            stateExtension="system/status",
            stateTransformation="JSONPATH:$.Task_LastErr"
        ]
  Type number : system_RTC_dev "Sensor Unix Time" [
            stateExtension="/time/status",
            stateTransformation="JSONPATH:$.System.Unix"
        ]
  Type contact : ntp_sync_dev "NTP Synchronisiert" [
            stateExtension="/time/status",
            stateTransformation="JSONPATH:$.System.Synced",
            closedValue="On",
            openValue="Off"
        ]
}
