# Per-device runtime config (real WiFi credentials/hostnames) — never commit a real one.
config.json
modules/config.json

# Build output (see build-*.sh)
python/build/
firmware.uf2
*.uf2

# scripts/build_frozen_html.sh output (SPECIFICATION.md Part A.9) - a plain build artifact,
# regenerated by scripts/test.sh before running tests, never committed (matches build-wozi.sh's
# own html/build/ handling for the real site). Deliberately NOT ".frozen/" - that exact string is a
# hardcoded sentinel in MicroPython's own import machinery (py/builtinimport.c's
# MP_FROZEN_PATH_PREFIX ".frozen/") that routes straight to the compiled-in frozen-module table and
# never touches the real filesystem at all - confirmed directly against the pinned v1.28.0 source
# after a real file placed there turned out to be silently unimportable. scripts/test.sh's own
# "src:tests:.frozen" MICROPYPATH keeps that real sentinel (needed for e.g. `import asyncio`)
# untouched; frozen_modules/ is a separate, ordinary directory added alongside it.
frozen_modules/

# Local editor/OS cruft
.DS_Store
__pycache__/
*.pyc

# Agent-tool-managed isolated git worktrees (each is its own nested checkout with its own .git) -
# local session scratch space, never repo content.
.claude/worktrees/

# Dev-tooling venv (uv sync) and MicroPython stubs (scripts/typecheck.sh) - both reinstallable,
# neither meant to be committed.
.venv/
typings/

# scripts/test.sh --coverage output (see tests/README.md) - regenerated every run, not meant to
# be committed.
htmlcov/
coverage.xml
coverage_summary.md
htmlcov_digital_twin/
coverage_digital_twin.xml
coverage_summary_digital_twin.md
.coverage

# Scratch config files written/removed by tests/test_config_manager.py's real file-I/O tests.
tests/_tmp/

# digital_twin/run_wozi_integration.py's own persistent run state -
# the twin's FRAM state (only written via machine.flush_fram() on shutdown, owner-specified default),
# its SCD30 NVM-settings state (machine.flush_scd30(), same
# shutdown-only convention), and its
# ConfigManager-backed config_*.cfg files - all plain, regenerable run artifacts, never committed.
digital_twin/fram_state.json
digital_twin/scd30_state.json
digital_twin/config/
