{
    // Node-context pass: the Vitest Commands API modules and their Node-only helpers, the npm test summary reporter and the
    // cross-browser smoke - server-side Node code, kept out of tsconfig.json's browser pass (see its
    // "exclude" comment); the same two-environment split as digital_twin/typecheck.ini.
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "lib": ["ES2022"],
        "types": ["node"],
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        // Everything TypeScript offers beyond `strict`, mirroring pyproject.toml's mypy settings; each held before it was
        // switched on, and the two that needed real fixes (exactOptionalPropertyTypes, noUncheckedIndexedAccess) were fixed
        // in js/, not left off. skipLibCheck stays true: the only findings it hides are in third-party .d.ts files.
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "allowUnreachableCode": false,
        "allowUnusedLabels": false,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true
    },
    "include": ["tests_js/_live_twin_command.js", "tests_js/_live_matrix_command.js", "tests_js/_lint_command.js", "tests_js/_summary_reporter.js", "tests_js/_port_lock.js", "tests_js/_twin_process.js", "scripts/cross_browser_smoke.mjs", "scripts/_cross_browser_probe.mjs", "scripts/_page_load_connections.mjs"]
}
