{
  "name": "sensors-website",
  "version": "0.1.0",
  "private": true,
  "description": "Dev-tooling config and source for the sensors website (html/, js/, tests_js/, mockdata/), not an installable package.",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26 <27",
      "onFail": "error"
    }
  },
  "scripts": {
    "lint": "eslint js tests_js scripts html eslint.config.js vitest.config.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build:definitions": "uv run scripts/_generate_sensortask_modules.py",
    "build:site": "npm run build:definitions && scripts/build_device_websites.sh",
    "pretest": "npm run build:site",
    "test": "vitest run",
    "pretest:unit": "npm run build:site",
    "test:unit": "vitest run --exclude \"**/node_modules/**\" --exclude \"tests_js/live-backend-put-matrix.test.js\"",
    "pretest:put-matrix": "npm run build:site",
    "test:put-matrix": "vitest run tests_js/live-backend-put-matrix.test.js",
    "pretest:coverage": "npm run build:site && uv run scripts/_archive_evidence.py --runner npm_coverage htmlcov_js",
    "test:coverage": "vitest run --coverage --exclude \"**/node_modules/**\" --exclude \"tests_js/live-backend-put-matrix.test.js\"",
    "lint:html": "html-validate \"html/**/*.html\"",
    "lint:css": "stylelint \"html/**/*.css\"",
    "lint:html:built": "scripts/build_device_websites.sh --stage-only build/staged_html && html-validate \"build/staged_html/*/index.html\"",
    "prepreview": "npm run build:definitions",
    "preview": "uv run scripts/preview_server.py"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-html": "^8.2.1",
    "globals": "^17.14.0",
    "html-validate": "^11.21.0",
    "playwright": "^1.65.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
