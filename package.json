{
  "name": "sensors-website",
  "version": "0.1.0",
  "private": true,
  "description": "Dev-tooling config and source for the sensors website (html/, js/, tests_js/, mockdata/), not an installable package.",
  "type": "module",
  "scripts": {
    "lint": "eslint js tests_js scripts html eslint.config.js vitest.config.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "pretest": "scripts/build_website.sh wozi && uv run scripts/_generate_sensortask_modules.py",
    "test": "vitest run",
    "pretest:coverage": "scripts/build_website.sh wozi && uv run scripts/_generate_sensortask_modules.py",
    "test:coverage": "vitest run --coverage",
    "lint:html": "html-validate \"html/**/*.html\"",
    "lint:css": "stylelint \"html/**/*.css\"",
    "preview": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-html": "^8.2.0",
    "globals": "^17.12.0",
    "html-validate": "^11.15.0",
    "playwright": "^1.63.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
